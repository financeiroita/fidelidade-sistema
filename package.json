{
  "name": "fidelidade",
  "version": "0.1.0",
  "private": true,
  "description": "CRM e programa de fidelidade para hotel",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:seed": "tsx prisma/seed.ts",
    "job:nightly": "tsx src/jobs/nightly.ts",
    "operator:create": "tsx src/jobs/createOperator.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "fastify": "^5.12.8",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
