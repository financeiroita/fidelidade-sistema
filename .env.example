DATABASE_URL="postgresql://fidelidade:fidelidade_dev@localhost:5432/fidelidade"
# Chave secreta (>= 32 caracteres) para proteger CPF/passaporte. Gere uma aleatória e NUNCA troque depois
# sem migrar os hashes. Guarde em local seguro (cofre de senhas).
DOCUMENT_HASH_SECRET=
PORT=3000
# Só quando o servidor estiver atrás de um proxy/balanceador SEU (ex.: Nginx, balanceador da nuvem).
# Valor = endereço(s) do proxy, separados por vírgula (IP ou faixa), para o limite de tentativas ver o IP real.
# Só pedidos vindos desses endereços podem informar o IP do visitante. Nunca use faixas amplas como 0.0.0.0/0.
# TRUST_PROXY_ADDRS=127.0.0.1
# Funcionários entram com usuário e senha (sem chave compartilhada).
# Crie o primeiro administrador com: npm run operator:create -- --username SEU_USUARIO --name "Seu Nome" --role ADMIN
